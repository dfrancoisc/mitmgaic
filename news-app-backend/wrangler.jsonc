{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "news-app-backend",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-23",
	"observability": {
		"enabled": true,
	},
	// 7 AM New York time: 11:00 UTC during daylight time, 12:00 UTC otherwise.
	// The scheduled handler skips whichever of the two isn't 7 AM locally.
	"triggers": {
		"crons": ["0 11 * * *", "0 12 * * *"],
	},
	// Semantic search: Workers AI embeds text, Vectorize stores one vector per article (id = articles.id).
	"ai": { "binding": "AI" },
	"vectorize": [{ "binding": "VECTORIZE", "index_name": "news-articles" }],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "news-db",
			"database_id": "1e25d0f7-63e1-4796-b240-3873367a493d",
			"migrations_dir": "migrations",
		},
	],
}
